{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Publisher overlay: exact dependency pins and per-commit release suppression."
  ],
  "extends": [
    "github>JFusco/renovate-config:standard"
  ],
  "rangeStrategy": "pin",
  "commitMessageSuffix": "[skip release]",
  "vulnerabilityAlerts": {
    "enabled": false,
    "automerge": false,
    "schedule": [],
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "groupName": null,
    "prCreation": "immediate",
    "commitMessageSuffix": "[SECURITY] [skip release]"
  }
}
